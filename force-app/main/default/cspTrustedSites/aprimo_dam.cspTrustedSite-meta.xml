<?xml version="1.0" encoding="UTF-8"?>
<!--
    PROVISIONAL. This allowlists the Aprimo DAM tenant domain for image rendering.

    The host that actually needs allowlisting is whatever serves rendition.publicuri, and
    that is not yet confirmed — public links may resolve to a separate CDN host rather than
    the tenant domain. Stage A of the vetting run reports the real host ("publicuri HOST
    (needs CSP)"); correct this file once it does.

    Not needed for the popup itself: window.open targets a new tab, not a frame, so
    frame-src does not apply.
-->
<CspTrustedSite xmlns="http://soap.sforce.com/2006/04/metadata">
    <canAccessCamera>false</canAccessCamera>
    <canAccessMicrophone>false</canAccessMicrophone>
    <context>All</context>
    <description>Aprimo DAM tenant — image rendering for selected assets</description>
    <endpointUrl>https://*.dam.aprimo.com</endpointUrl>
    <isActive>true</isActive>
    <isApplicableToConnectSrc>false</isApplicableToConnectSrc>
    <isApplicableToFontSrc>false</isApplicableToFontSrc>
    <isApplicableToFrameSrc>false</isApplicableToFrameSrc>
    <isApplicableToImgSrc>true</isApplicableToImgSrc>
    <isApplicableToMediaSrc>true</isApplicableToMediaSrc>
    <isApplicableToStyleSrc>false</isApplicableToStyleSrc>
</CspTrustedSite>
