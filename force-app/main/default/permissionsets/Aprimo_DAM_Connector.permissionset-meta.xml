<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Aprimo DAM Connector</label>
    <description>Grants access to the Aprimo DAM connector. Assign to CMS content authors and to whoever runs provider registration.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>AprimoBridgeLog</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AprimoProviderAdmin</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AprimoDamConfigController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>Bridge_Finding__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Bridge_Finding__c.Payload__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Bridge_Finding__c.Mode__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Bridge_Finding__c.Outcome__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
